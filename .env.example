# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
# Model theo vai trò: rẻ cho analyst, mạnh cho report
MONEYFLOW_MODEL_ANALYST=claude-sonnet-5-5
MONEYFLOW_MODEL_REPORT=claude-opus-5-5
# Server-side refusal fallback ("default" để bật, để trống để tắt)
MONEYFLOW_LLM_FALLBACKS=default

# --- Dữ liệu ---
FINNHUB_KEY=
# Email liên hệ bắt buộc trong User-Agent khi gọi SEC EDGAR
SEC_USER_AGENT="moneyflow-agents you@example.com"
MONEYFLOW_DB_PATH=data/moneyflow.duckdb

# --- Output ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability (tuỳ chọn) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
